# =============================================================================
#  Copy this file to `.env` and fill in what you need.  Lines starting with #
#  are comments.  Every value has a default, so a minimal .env only needs the
#  OPENAI_API_KEY line.
# =============================================================================

# ---------- 1. Which AI provider? --------------------------------------------
# openai = OpenAI cloud (needs a key)      ollama = 100% local, free (needs Ollama installed)
LLM_PROVIDER=openai
# Paste your key after the = sign (it starts with sk-)
OPENAI_API_KEY=
# Chat model used for answers AND for the memory pipeline (extraction / decisions)
LLM_MODEL=gpt-4o-mini
# Optional: point the OpenAI SDK at another OpenAI-compatible server (Azure, vLLM, ...)
# OPENAI_BASE_URL=

# ---------- 2. Embeddings (text -> vectors for Qdrant) -----------------------
# Defaults follow LLM_PROVIDER. Override to mix providers, e.g. local LLM + OpenAI embeddings.
# EMBEDDER_PROVIDER=openai
# EMBED_MODEL=text-embedding-3-small
# EMBED_DIMS=1536
#
# Fully local example (uncomment these 5 lines and comment the OpenAI ones above):
# LLM_PROVIDER=ollama
# LLM_MODEL=llama3.1:8b
# EMBEDDER_PROVIDER=ollama
# EMBED_MODEL=nomic-embed-text
# EMBED_DIMS=768
# Where Ollama runs when you run the Python code on your machine
OLLAMA_BASE_URL=http://localhost:11434
# Where Ollama runs as seen from INSIDE the app container (docker compose --profile app):
#   Ollama installed on your computer -> http://host.docker.internal:11434  (default)
#   Ollama via `--profile local`      -> http://ollama:11434
# OLLAMA_BASE_URL_DOCKER=http://host.docker.internal:11434

# ---------- 3. Qdrant (started by docker compose) ----------------------------
QDRANT_HOST=localhost
QDRANT_PORT=6333
# Use a NEW collection name whenever you change the embedding model/dims.
QDRANT_COLLECTION=agent_memories
# SQLite file with the ADD/UPDATE/DELETE history of every memory
HISTORY_DB_PATH=./data/mem0_history.db

# ---------- 4. Memory pipeline tuning -----------------------------------------
# custom = our two-phase pipeline (summarize -> extract -> add/update/delete)
# mem0   = let Mem0's built-in extraction do it (the tutorial-video approach)
MEMORY_PIPELINE=custom
RECALL_TOP_K=5             # memories injected into each answer
SIMILAR_TOP_K=5            # existing memories compared against each new fact
SUMMARY_REFRESH_EVERY=3    # refresh the rolling summary every N turns
RECENT_MESSAGES_WINDOW=6   # how many recent messages of the current session go into the prompt
LEARN_IN_BACKGROUND=false  # true = learn in a thread so replies are not delayed

# ---------- 5. Cost estimate (USD per 1M tokens; edit to match your provider's price list) ----
PRICE_INPUT_PER_1M_TOKENS=0.15
PRICE_OUTPUT_PER_1M_TOKENS=0.60

# ---------- 6. Misc -------------------------------------------------------------
DEFAULT_USER_ID=demo_user
LOG_LEVEL=INFO             # DEBUG shows every LLM call and Mem0 message
MEM0_TELEMETRY=false       # keep Mem0 from sending anonymous usage stats
