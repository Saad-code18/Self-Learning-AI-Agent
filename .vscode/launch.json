{
  // Press F5 (or the green ▶ in "Run and Debug") and pick one of these.
  // They all run from the project root and read your .env automatically.
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Chat (CLI)",
      "type": "debugpy",
      "request": "launch",
      "program": "${workspaceFolder}/scripts/chat.py",
      "console": "integratedTerminal",
      "cwd": "${workspaceFolder}",
      "justMyCode": true
    },
    {
      "name": "Check setup",
      "type": "debugpy",
      "request": "launch",
      "program": "${workspaceFolder}/scripts/check_setup.py",
      "console": "integratedTerminal",
      "cwd": "${workspaceFolder}"
    },
    {
      "name": "API server (FastAPI)",
      "type": "debugpy",
      "request": "launch",
      "module": "uvicorn",
      "args": ["memory_agent.api:app", "--reload", "--app-dir", "src", "--port", "8000"],
      "console": "integratedTerminal",
      "cwd": "${workspaceFolder}"
    },
    {
      "name": "Benchmark (memory vs baselines)",
      "type": "debugpy",
      "request": "launch",
      "program": "${workspaceFolder}/scripts/benchmark.py",
      "console": "integratedTerminal",
      "cwd": "${workspaceFolder}"
    },
    {
      "name": "Seed 1,100 memories",
      "type": "debugpy",
      "request": "launch",
      "program": "${workspaceFolder}/scripts/seed_memories.py",
      "console": "integratedTerminal",
      "cwd": "${workspaceFolder}"
    },
    {
      "name": "Inspect memories",
      "type": "debugpy",
      "request": "launch",
      "program": "${workspaceFolder}/scripts/inspect_memories.py",
      "args": ["--history"],
      "console": "integratedTerminal",
      "cwd": "${workspaceFolder}"
    },
    {
      "name": "Run tests",
      "type": "debugpy",
      "request": "launch",
      "module": "pytest",
      "args": ["-v"],
      "console": "integratedTerminal",
      "cwd": "${workspaceFolder}"
    }
  ]
}
